          "name": "Send WhatsApp Message",
          "request": {
            "name": "Send WhatsApp Message",
            "description": {
              "content": "Send a single WhatsApp message to a contact. If there is no existing contact with the phone number a contact will be created.\n\nExactly one of \"contactId\", \"fullPhoneNumber\", or \"phoneNumber\" with \"phoneNumberCountry\" need to be set.\n\nRetries: The WhatsApp API automatically re-tries failed messages as often as possible within 24 hours by default. To know until when we'll keep retrying your message, you can refer to the deliveryDeadline of the POST response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "whatsapp",
                "contact"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orgId\": \"<integer>\",\n  \"from\": \"<string>\",\n  \"message\": \"<string>\",\n  \"image\": \"<string>\",\n  \"audio\": \"<string>\",\n  \"video\": \"<string>\",\n  \"document\": \"<string>\",\n  \"content\": \"<object>\",\n  \"contactId\": \"<integer>\",\n  \"fullPhoneNumber\": \"<string>\",\n  \"phoneNumber\": \"<string>\",\n  \"phoneNumberCountry\": \"<string>\"\n}",
