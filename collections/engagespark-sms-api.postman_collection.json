        {
          "id": "23c1389f-558f-448c-9bf3-088f8e774658",
          "name": "Send an SMS to a contact",
          "request": {
            "name": "Send an SMS to a contact",
            "description": {
              "content": "Send a single SMS to a contact. If there is no existing contact with the phone number a contact will be created.\n\nUnicode and multi-part SMS are supported. See `message` for details.\n\nExactly one of \"contactId\", \"fullPhoneNumber\", or \"phoneNumber\" with \"phoneNumberCountry\" need to be set.\n\nRetries: The SMS API automatically re-tries failed messages as often as possible within 24 hours by default. To know until when we’ll keep retrying your message, you can refer to the deliveryDeadline of your POST request.\n\nTesting frequency: In many countries, mobile network operators limit the number of SMS you can send to a single number per minute often to 5 SMS/number/minute. If you send more than five SMS to a single number within a minute, some messages may not get through and will be lost.\n\nThis is the normal API for sending an SMS.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "sms",
                "contact"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orgId\": \"<integer>\",\n  \"from\": \"<string>\",\n  \"message\": \"<string>\",\n  \"clientDedup\": \"<string>\",\n  \"clientPushURL\": \"<string>\",\n  \"clientRef\": \"<string>\",\n  \"contactId\": \"<integer>\",\n  \"fullPhoneNumber\": \"<string>\",\n  \"phoneNumber\": \"<string>\",\n  \"phoneNumberCountry\": \"<string>\",\n  \"to\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
